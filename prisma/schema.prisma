// Prisma schema for the OryCMS Next.js app (orycms/), backed by Neon Postgres.
//
// The OryCMS core (orycms/orycms/**) manages its own system tables (users,
// roles, content, etc.) directly through the `pg` driver and its own
// migration engine - that schema is untouched by Prisma. This file is for
// any additional application-level data models built on top of the same
// Neon database; add `model` blocks here as those are needed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}
