# OryCMS — single global environment file for the whole project.
#
# This is the ONLY .env in the project. It lives at the repo root because
# there is exactly one Next.js app here (root package.json/next.config.ts);
# Next.js and the Prisma CLI both load it automatically at runtime/build
# time. Don't add another .env anywhere else in the tree.
#
# All three DB vars below point at the SAME Neon project/database
# ("neondb"). Switched 2026-09-02 from the previous "orycms" project
# (ep-solitary-frost-awgm04do, us-east-1) to this one at the user's request —
# the old project's data (clients, announcements, roles, users) was NOT
# migrated; this is a fresh database that bootstrapOryCMS installs schema +
# seeds into on first use (see app/api/orycms/auth/setup/route.ts).

# Pooled endpoint (PgBouncer transaction mode) — used by the app's runtime
# PrismaClient via the driver adapter (see orycms/lib/prisma.ts).
DATABASE_URL=

# Direct (non-pooled) endpoint — required for the Prisma CLI
# (generate/migrate/db push) and for OryCMS's own migration engine, both of
# which run raw multi-statement DDL that PgBouncer's transaction pooling
# mode can hang on.
DIRECT_URL=
ORYCMS_DATABASE_URL=

# Base URL OryCMS uses to build absolute links (invite emails, password
# resets — see orycms/auth/token-links.ts). Falls back to the request's own
# origin when unset, but set it explicitly once this is deployed anywhere
# other than localhost.
ORYCMS_APP_URL=http://localhost:3000

# ── Email (SMTP) ──────────────────────────────────────────────────────────
# SMTP_PASS is still blank — fill it in, then emails send for real. Until
# it's set, sendmail fails and OryCMS falls back to "dev mode": no email is
# sent and the API response returns the raw link instead (see
# orycms/auth/token-links.ts) — safe default, nothing breaks meanwhile.
ORYCMS_EMAIL_PROVIDER=smtp
ORYCMS_EMAIL_FROM="OryCMS <admin@orynticlabs.com>"
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=


# ── Media storage (Cloudinary) ───────────────────────────────────────────
ORYCMS_STORAGE_PROVIDER=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── MFA (TOTP secret encryption) ─────────────────────────────────────────
# Base64, 32 raw bytes (AES-256-GCM key) — see orycms/auth/mfa.crypto.ts.
# Encrypts TOTP secrets before they're stored in orycms_users.mfaSecret; the
# key itself lives only here, never in Postgres and never sent to the
# client. Generated for local dev with `openssl rand -base64 32` — rotate
# per environment (dev/staging/prod each need their own).
ORYCMS_MFA_ENCRYPTION_KEY=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=


# Encryption keys for Gemini/WhatsApp plugin settings (AES-256-GCM at-rest secrets)
ORYCMS_GEMINI_ENCRYPTION_KEY=
ORYCMS_WHATSAPP_ENCRYPTION_KEY=